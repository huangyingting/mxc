{
  "filesystem": {
    "readonlyPaths": ["input"],
    "readwritePaths": ["output"],
    "deniedPaths": ["protected/denied.txt"]
  },
  "network": {
    "egress": {
      "default": "deny"
    },
    "ingress": {
      "default": "deny",
      "hostLoopback": "deny"
    }
  },
  "ui": {
    "disable": true,
    "clipboard": "none",
    "allowInputInjection": false
  }
}
