{
  "name": "mxc-sdk-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run check",
    "demo": "npm run build && node dist/main.js",
    "demo:session": "npm run build && node dist/session.js",
    "demo:pty": "npm run build && node dist/pty.js",
    "demo:pty:interactive": "npm run build && node dist/pty.js --interactive",
    "demo:all": "npm run demo && npm run demo:session && npm run demo:pty"
  },
  "dependencies": {
    "@microsoft/mxc-sdk": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "koffi@3.3.8": true,
    "node-pty@1.1.0": true
  }
}
